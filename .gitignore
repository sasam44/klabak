# Dependencies (installed with `npm install`; every workspace member is tracked)
node_modules/

# Build output for the game page (Vercel rebuilds it from source)
examples/*/dist/

# Local tooling state
*.log
.vercel

# Written by the local node at boot; regenerated by `npm run start:klabak`
simulator/local-node/deployed.json

# NOTE: the upstream SDK .gitignore excludes local-verify-network/ and slot-engine/
# because it publishes them separately. This submission repository tracks both on
# purpose: `npm install` + `npm start:klabak` must work from a fresh clone, and the
# local node loads the VRF node from local-verify-network/.
.env*
